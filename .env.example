# Google Gemini API key used by scripts/generate-blog.mjs (the daily AI blog generator).
# Create one (free) at https://aistudio.google.com/apikey
# Copy this file to `.env` and fill it in. NEVER commit your real key.
# In CI, set this as the GitHub Actions secret GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the model (defaults to gemini-flash-latest).
# GEMINI_MODEL=gemini-pro-latest
