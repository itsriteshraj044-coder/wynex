# Apache / LiteSpeed config for Hostinger. Vite copies this into dist/, so it is
# deployed to public_html/ alongside index.html.

Options -MultiViews
RewriteEngine On

# --- Canonical URL: https://wynextechnologies.com (no www) ---------------------
RewriteCond %{HTTP_HOST} ^www\.wynextechnologies\.com$ [NC]
RewriteRule ^ https://wynextechnologies.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^wynextechnologies\.com$ [NC]
RewriteRule ^ https://wynextechnologies.com%{REQUEST_URI} [L,R=301]

# --- Removed duplicate blog posts -> the original article ----------------------
RewriteRule ^blog/optimizing-vector-search-performance-postgresql-pgvector-hnsw-indexes/?$ /blog/optimizing-vector-search-performance-postgres-pgvector-hnsw [L,R=301]
RewriteRule ^blog/optimizing-api-gateway-performance-with-distributed-rate-limiting/?$ /blog/optimizing-api-gateway-performance-distributed-rate-limiting [L,R=301]
RewriteRule ^blog/mastering-distributed-rate-limiting-for-high-scale-apis/?$ /blog/optimizing-api-gateway-performance-distributed-rate-limiting [L,R=301]
RewriteRule ^blog/optimizing-database-query-performance-with-advanced-indexing-strategies/?$ /blog/optimizing-database-query-performance-advanced-indexing [L,R=301]
RewriteRule ^blog/optimizing-database-connection-pooling-and-resilient-failover-in-distributed-mic/?$ /blog/mastering-connection-pooling-resilient-failover-distributed-microservices [L,R=301]
RewriteRule ^blog/optimizing-postgresql-connection-pooling-resilient-failover-distributed-microser/?$ /blog/mastering-connection-pooling-resilient-failover-distributed-microservices [L,R=301]

# --- Pre-rendered pages (written by scripts/prerender.ts) -------------------------
# /about -> /_pages/about.html, /blog/<slug> -> /_pages/blog/<slug>.html, / -> /_pages/index.html.
# Each has the page's own title, meta tags and content for crawlers and link
# previews; React takes over once it loads. Anything without a file falls through
# to the SPA fallback below.
RewriteRule ^$ /_pages/index.html [L]
RewriteCond %{DOCUMENT_ROOT}/_pages%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ /_pages/$1.html [L]

# --- SPA fallback ---------------------------------------------------------------
# Client-side routes (/blog, /blog/:slug, /privacy, …) load index.html. Requests
# for real files, or anything with a file extension, are left alone so a missing
# asset is a real 404 rather than an HTML page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^ /index.html [L]

# --- Caching ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build output (e.g. index-BwOI-7QD.js) never changes; cache it for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate the HTML so visitors pick up new deploys and blog posts.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
